# Database connection string
DATABASE_URL="postgresql://user:password@localhost:5432/finance_app?schema=public"

# JWT Configuration
JWT_ACCESS_SECRET="your-super-secret-access-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS="12"

# CORS Configuration
CORS_ORIGIN="http://localhost:3001"

# Market Data
# Provider for investment quotes: "mock" (simulated demo data, default) or "finnhub" (live).
# When set to finnhub, FINNHUB_API_KEY must be provided or it falls back to mock.
MARKET_DATA_PROVIDER="mock"
FINNHUB_API_KEY=""
